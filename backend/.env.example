# Servidor
PORT=4000
NODE_ENV=development

# MongoDB Atlas (la base se llama omniahub)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/omniahub?retryWrites=true&w=majority

# Autenticación
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=1d

# URL del frontend (CORS)
CLIENT_URL=http://localhost:5173
